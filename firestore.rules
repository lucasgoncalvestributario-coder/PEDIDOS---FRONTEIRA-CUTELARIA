rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção principal da Cutelaria Fronteira
    match /pedidosfronteira/{orderId} {
      // Permite leitura e escrita para que celulares, tablets e computadores sincronizem
      allow read, write: if true;
    }

    // Compatibilidade com coleção legada
    match /orders/{orderId} {
      allow read, write: if true;
    }
  }
}

